[Unit]
Description=Nightly Google Drive pull

[Timer]
# 01:00 — finishes before the database dumps (02:00, 02:30) and the restic
# backup (03:00), so anything pulled tonight is backed up the same night.
OnCalendar=*-*-* 01:00:00
Persistent=true
RandomizedDelaySec=600

[Install]
WantedBy=timers.target
