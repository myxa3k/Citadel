# --- Secrets -----------------------------------------------------------------
# Only *.env.example ever gets committed. Real .env files — never.
.env
*.env
!*.env.example
rclone.conf
*.key
*.pem
id_ed25519*
id_rsa*
authorized_keys

# --- Service data --------------------------------------------------------------
# Live database and cache directories. Gigabytes, constantly changing, and a
# live copy wouldn't be restorable anyway — nightly dumps exist for that.
immich/postgres/
owncloud/mysql/
owncloud/redis/

# --- Junk ----------------------------------------------------------------------
*.log
*.partial
*.bak
*.swp
.DS_Store
