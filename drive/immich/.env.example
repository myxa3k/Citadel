# ---- Immich ----------------------------------------------------------------
IMMICH_VERSION=v3.1.0

# Media library: 1T HDD (ZFS mirror). Everything Immich stores lives here.
UPLOAD_LOCATION=/mnt/hdd/immich

# Database: NVMe. Postgres on a spinning disk makes Immich painfully slow.
DB_DATA_LOCATION=/home/shiro/Citadel/drive/immich/postgres

# Sets the timezone used for photo dates/timestamps in the UI — pick the
# actual value for this install from `timedatectl list-timezones`.
TZ=<Region/City>

DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
