# ---- ownCloud --------------------------------------------------------------
OWNCLOUD_VERSION=11.0.0

# Replace <tailscale-hostname>/<tailscale-ip> with this machine's actual
# values (see ../ENVIRONMENT.md for how to look them up) when copying this
# to a real .env — don't leave the placeholders in a running config.
OWNCLOUD_DOMAIN=<tailscale-hostname>:8443
OWNCLOUD_TRUSTED_DOMAINS=<tailscale-hostname>:8443,<tailscale-hostname>,localhost:8080,127.0.0.1:8080,<tailscale-ip>:8080,owncloud.citadel-home.xyz,files.citadel-home.xyz,cloud.citadel-home.xyz,drive.citadel-home.xyz

ADMIN_USERNAME=shiro
ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

DB_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
