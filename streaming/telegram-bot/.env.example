# --- Telegram ----------------------------------------------------------------
# Same bot as the rest of the Citadel (Amadeus). One bot can both send
# notifications and answer commands; what it must NOT have is a second process
# also reading its updates -- only this bot polls.
TELEGRAM_BOT_TOKEN=<token-from-BotFather>
# Negative number starting -100 for a supergroup. See telegram/README.md.
TELEGRAM_CHAT_ID=<chat-id>
# message_thread_id of the "Streaming" topic. Leave empty to answer in General.
TELEGRAM_TOPIC_STREAMING=

# Comma-separated Telegram user IDs allowed to command the bot.
# Empty means anyone in the chat above -- fine for a private group.
ALLOWED_USER_IDS=

# --- Prowlarr ------------------------------------------------------------------
# Reached over the compose network, so the container name is the hostname.
PROWLARR_URL=http://streaming_prowlarr:9696
PROWLARR_API_KEY=<prowlarr-api-key>

# --- qBittorrent ---------------------------------------------------------------
QBITTORRENT_URL=http://streaming_qbittorrent:8080
QBITTORRENT_USER=<webui-username>
QBITTORRENT_PASS=<webui-password>

# Where each category lands. These are paths *inside* the qBittorrent
# container, which mounts /mnt/storage as /data.
PATH_ANIME=/data/downloads/anime
PATH_SERIES=/data/downloads/series
PATH_MOVIES=/data/downloads/movies

# Where a finished download gets hardlinked so Jellyfin can see it. The bot
# mounts /mnt/storage at the same /data path, so downloads and media share a
# filesystem and linking costs nothing.
MEDIA_ANIME=/data/media/anime
MEDIA_SERIES=/data/media/series
MEDIA_MOVIES=/data/media/movies

# --- Jellyfin (optional) -------------------------------------------------------
# Only used to trigger a library rescan; the bot works without it.
JELLYFIN_URL=http://streaming_jellyfin:8096
JELLYFIN_API_KEY=

# --- Followed shows ------------------------------------------------------------
# Where /follow keeps its list. Lives on a mounted volume so it survives a
# rebuild of the image.
FOLLOW_STATE=/state/following.json
