# Credentials for /usr/local/bin/notify.sh — a generic Telegram push used
# across the whole Citadel infrastructure, not just this VM.
#
# Copy this file to /etc/telegram-notify.env on ANY host that should be able
# to push into the same chat (the Proxmox node, another LXC, another VM),
# fill in the same values, chmod 600 it, and copy scripts/notify.sh to
# /usr/local/bin/ on that host too. That's the entire setup — no central
# service, no registration step, just a shared token and chat id.
#
# Get the token from @BotFather in Telegram. Get the chat id and topic
# thread ids via https://api.telegram.org/bot<TOKEN>/getUpdates after
# messaging the bot / posting "/id" in each topic — see docs/notifications.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Topic routing (optional). Only relevant if TELEGRAM_CHAT_ID is a Telegram
# supergroup with Topics enabled. A category with no matching variable here
# — or no topics set up at all — just posts to the group's default stream
# (its built-in "General" topic), which is exactly what this repo's own
# health-watch.sh relies on for its "system" category: General can't be
# deleted anyway, so it's the natural home for anything not tied to a
# specific service.
#
# Example values actually in use on shiro-drive as of 2026-09:
#   TELEGRAM_TOPIC_IMMICH=5      # topic "Drive" — shared with ownCloud
#   TELEGRAM_TOPIC_OWNCLOUD=5    # topic "Drive" — shared with Immich
#   TELEGRAM_TOPIC_BACKUPS=8     # topic "Backups"
#   (no TELEGRAM_TOPIC_SYSTEM — falls through to General on purpose)
TELEGRAM_TOPIC_IMMICH=
TELEGRAM_TOPIC_OWNCLOUD=
TELEGRAM_TOPIC_BACKUPS=
TELEGRAM_TOPIC_SYSTEM=
